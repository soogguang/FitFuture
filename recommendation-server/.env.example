# Default real mode NEVER falls back to fixtures when a key/data source is missing.
RECOMMENDATION_MODE=real
# Optional: connect Gemini candidates while keeping the existing nutrition configuration.
# With RECOMMENDATION_MODE=fixture, nutrients remain synthetic and are labelled as such.
# CANDIDATE_GENERATOR=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MFDS_API_KEY=
# 미설정 시 앱과 같은 식약처 음식 DB(app/src/main/assets/nutrition)와 evidence/ 근거 파일을 사용합니다.
# 검토한 JSON 스냅샷(가격 제공 조건 포함)을 쓰려면 경로를 지정하세요.
# MFDS_CATALOG_PATH=data/mfds.json
# 근거 데이터 수집용 (선택). NEIS 키가 없으면 5건씩 느리게 수집합니다. 서울 키는 가격 수집에 필요합니다.
NEIS_API_KEY=
SEOUL_API_KEY=
# Optional; all weights must add up to 1.
# SCORING_CONFIG_PATH=fitfuture/scoring.json
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
